# ==============================================================================
# SQL Assistant - .gitignore
# ==============================================================================

# ----------------------------
# Virtual Environment
# ----------------------------
.venv/
.env/
env/
venv/
ENV/
.env.local
.env.*.local

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
uv.lock
pip-selfcheck.json
.hypothesis/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ----------------------------
# Build Artifacts
# ----------------------------
dist/
build/
*.whl
*.egg
.installed.cfg

# ----------------------------
# IDE & Editor
# ----------------------------
.vscode/
.idea/
.project
.pydevproject
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Logs
# ----------------------------
*.log
logs/
*.log.*
.logs/

# ----------------------------
# Configuration & Data
# ----------------------------
# 项目数据目录（配置、数据库、运行时数据）
.data/
# 旧版配置路径
~/.sql-assistant/
.sql-assistant/
# SQLite数据库文件
*.db
*.sqlite
*.sqlite3
*.db-journal

# ----------------------------
# Backup
# ----------------------------
# 数据库备份目录
backups/

# ----------------------------
# Security
# ----------------------------
*.pem
*.key
*.cert
*.crt
secrets/
.vault/

# ----------------------------
# Node.js (if used)
# ----------------------------
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ----------------------------
# Trae IDE
# ----------------------------
.codegraph/

# ----------------------------
# DeepSeek
# ----------------------------
.deepseek/

# ----------------------------
# Trae IDE Rules
# ----------------------------
.trae/

# ----------------------------
# Cache
# ----------------------------
.cache/
*.egg
